/* Power menu theme — matches the qtile bar palette (see config.py, dict C).
   Used only by the bar's power button; the app launcher keeps config.rasi's
   Tokyo Night colours. */

* {
    bg:       #1e1e1e;   /* C[bg_topbar]          */
    bg-alt:   #3e0d5c;   /* C[bg_topbar_arrow]    */
    fg:       #e0e0e0;   /* C[fg_normal]          */
    fg-dim:   #6200ea;   /* C[border_normal]      */
    accent:   #aa00ff;   /* C[bg_topbar_selected] */
    urgent:   #ff6b6b;   /* C[fg_urgent]          */

    background-color: transparent;
    text-color:       @fg;
    font:             "0xProto Nerd Font 13";
}

window {
    location:         center;
    anchor:           center;
    width:            22em;
    border:           2px;
    border-color:     @accent;
    border-radius:    10px;
    background-color: @bg;
    padding:          0;
}

mainbox  { children: [ inputbar, listview ]; spacing: 0; padding: 0; }

inputbar {
    children:         [ prompt, entry ];
    padding:          12px 16px;
    spacing:          10px;
    background-color: @bg-alt;
    border:           0 0 1px 0;
    border-color:     @accent;
}

prompt  { text-color: @fg; }
entry   { text-color: @fg; placeholder: ""; }

listview {
    lines:        6;
    columns:      1;
    scrollbar:    false;
    fixed-height: false;
    padding:      8px;
    spacing:      2px;
    dynamic:      true;
    background-color: transparent;
}

element { padding: 9px 12px; spacing: 12px; border-radius: 6px; }

/* rofi merges its built-in default theme underneath this file, and that theme
   sets per-state element colours. A plain `element` rule loses to those, so
   each state is named explicitly (same reason as in config.rasi). */
element normal.normal    { background-color: transparent; text-color: @fg;     }
element alternate.normal { background-color: transparent; text-color: @fg;     }
element selected.normal  { background-color: @accent;     text-color: @bg;     }
element normal.active    { background-color: transparent; text-color: @accent; }
element alternate.active { background-color: transparent; text-color: @accent; }
element selected.active  { background-color: @accent;     text-color: @bg;     }
element normal.urgent    { background-color: transparent; text-color: @urgent; }
element alternate.urgent { background-color: transparent; text-color: @urgent; }
element selected.urgent  { background-color: @urgent;     text-color: @bg;     }

/* rofi-power-menu emits the glyph as an icon *name*, which resolves to no file
   and would otherwise leave a blank icon column. The glyph is in the row text
   already, so the column is turned off. */
element-icon { enabled: false; size: 0; }
element-text { vertical-align: 0.5; background-color: transparent; text-color: inherit; }

message  { padding: 10px; background-color: @bg-alt; }
textbox  { text-color: @fg; }
error-message { padding: 12px; background-color: @bg; }
