# {{ ansible_managed }}
# Rendered by roles/hyprland into ~/.config/uwsm/env. uwsm sources this before
# the compositor starts and exports it to the systemd user manager, so services
# started under graphical-session.target see it too. hl.env in hyprland.lua
# only ever reached Hyprland's own children.

export XCURSOR_SIZE=24
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Qt apps have no theme of their own here; the gtk3 platform theme plugin makes
# them follow GTK. On Arch that plugin (platformthemes/libqgtk3.so) is shipped
# by qt5-base and qt6-base themselves. roles/hyprland installs gtk3 so the
# plugin has something to read.
export QT_QPA_PLATFORMTHEME=gtk3

# Route GTK and Qt through ibus (autostart-apps/ibus.service). ibus has no
# input-method-v2 support, so without these Wayland-native apps never reach it.
# XMODIFIERS covers X clients under XWayland, via ibus-daemon --xim.
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus
{% if gpu == 'nvidia' %}

# NVIDIA, see https://wiki.hypr.land/nvidia/
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct
{% endif %}
