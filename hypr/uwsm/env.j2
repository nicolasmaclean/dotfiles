# {{ ansible_managed }}
# Rendered by roles/hyprland into ~/.config/uwsm/env. uwsm sources this before
# the compositor starts and exports it to the systemd user manager, so services
# started under graphical-session.target see it too. hl.env in hyprland.lua
# only ever reached Hyprland's own children.

export XCURSOR_SIZE=24
export ELECTRON_OZONE_PLATFORM_HINT=auto
{% if gpu == 'nvidia' %}

# NVIDIA, see https://wiki.hypr.land/nvidia/
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export NVD_BACKEND=direct
{% endif %}
