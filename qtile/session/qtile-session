#!/bin/sh
# Launch qtile as a systemd-aware X11 session.
# Referenced by /usr/share/xsessions/qtile.desktop (Exec=).

# Qt apps have no theme of their own here; the gtk3 platform theme plugin makes
# them follow GTK. On Arch that plugin (platformthemes/libqgtk3.so) is shipped
# by qt5-base and qt6-base themselves — there is no separate package to install,
# unlike Ubuntu's qt5-gtk2-platformtheme / qt6-gtk-platformtheme. roles/xorg
# installs gtk3 so the plugin has something to read.
export QT_QPA_PLATFORMTHEME=gtk3

# Input method. ibus.service starts the daemon (--xim, and it owns the layout
# this session cycles through); these three tell toolkits to route through it.
# GTK and Qt apps read their own variables, and XMODIFIERS is what everything
# else — including the XIM path ibus-daemon --xim serves — looks at. Exported
# before the import-environment below so the user units inherit them too.
export GTK_IM_MODULE=ibus
export QT_IM_MODULE=ibus
export XMODIFIERS=@im=ibus

# Make the X display + session vars visible to systemd --user and dbus,
# so user services started by qtile-session.target can reach the display.
systemctl --user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP QT_QPA_PLATFORMTHEME GTK_IM_MODULE QT_IM_MODULE XMODIFIERS
fi

# cnick's three-monitor desk: HDMI-0 in the middle (primary, landscape),
# HDMI-1 on the left mounted in portrait, DP-1 on the right (landscape).
# Applied here rather than left to whatever X/the driver autodetects, and
# before qtile starts rather than from a qtile hook, so there is one xrandr
# layout in effect for the whole session and qtile's own screen detection
# never has to unwind a wrong initial guess.
#
# Guarded by output name rather than hostname: it is a no-op wherever these
# three outputs are not all connected (unick's single panel, a nested test
# session, a future change of cabling), rather than hardcoding "only on
# cnick" and needing an edit here every time the desk changes.
#
# HDMI-1's rotated size is 1080x1920 (--rotate left turns the 1920x1080
# mode on its side). Positions below are left-to-right and contiguous -
# HDMI-1 at x=0..1080, DP-1 at 1080..3000, HDMI-0 at 3000..4920 - which is
# what a --pos of 840/1920/3840 (DP-1 kept at its old, pre-rotation x)
# actually resolves to: the driver normalizes the whole virtual screen so
# its leftmost occupied pixel sits at x=0, trimming what would otherwise be
# 840px of dead root-window space to the left of HDMI-1. Written as the
# already-normalized values so this matches what `xrandr --query` reports
# after it runs, instead of the pre-normalization numbers that were handed
# to it.
# Top-aligned (y=0) against DP-1's y=0: HDMI-1's taller portrait frame
# extends 840px below the other two, rather than floating above them.
#
# DP-1, not HDMI-0, is the physical middle monitor and HDMI-0 is the
# physical right one - confirmed by blanking each output live and watching
# which physical panel went dark. The connector names don't sort the way
# their desk position does; do not "simplify" this back to alphabetical.
if command -v xrandr >/dev/null 2>&1 \
    && xrandr --query | grep -q '^HDMI-0 connected' \
    && xrandr --query | grep -q '^HDMI-1 connected' \
    && xrandr --query | grep -q '^DP-1 connected'; then
    xrandr \
        --output HDMI-1 --pos 0x0 --rotate left \
        --output DP-1 --primary --pos 1080x0 --rotate normal \
        --output HDMI-0 --pos 3000x0 --rotate normal
fi

exec "$HOME/.local/bin/qtile" start -b x11
