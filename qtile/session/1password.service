[Unit]
Description=1Password tray app
PartOf=qtile-session.target
After=qtile-session.target
Requisite=qtile-session.target

[Service]
Type=simple
# --silent leaves only the tray icon, same reasoning as protonvpn.service: the
# target starts from config.py's startup_once, by which point the bar's
# StatusNotifier already owns the watcher name on the bus.
ExecStart=/usr/bin/1password --silent
# on-failure, not always: quitting from the tray is a clean exit and should
# stay quit until the next login.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=qtile-session.target
