[Desktop Entry]
Name=Qtile
Comment=Qtile tiling window manager (X11)
# A .desktop file cannot expand variables, so the path has to be written in.
# Rendered by Ansible's qtile role, and by install-session.sh until that lands
# - both substitute the same placeholder, /usr/local/bin/qtile-session.
# It must not be under $HOME: the greeter runs as its own user (`greeter`
# under greetd), and with home at 700 a TryExec it cannot stat makes the
# session silently disappear from the list.
Exec={{ qtile_session_bin }}
TryExec={{ qtile_session_bin }}
Type=Application
DesktopNames=qtile
Keywords=tiling;wm;windowmanager;window;manager;
