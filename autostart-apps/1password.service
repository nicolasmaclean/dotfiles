[Unit]
Description=1Password tray app
PartOf=graphical-session.target
Wants=quickshell.service
After=graphical-session.target quickshell.service
Requisite=graphical-session.target

[Service]
# --silent leaves only the tray icon, which is why this waits for quickshell:
# it owns the StatusNotifierWatcher the icon docks with.
ExecStart=/usr/bin/1password --silent
# on-failure, not always: quitting from the tray is a clean exit and should
# stay quit until the next login.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
