[Unit]
Description=Email client
PartOf=graphical-session.target
Wants=quickshell.service
After=graphical-session.target quickshell.service
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/mailspring --background
Restart=on-failure
RestartSec=2
# Exit 1 means another instance already holds the lock. Restarting would
# poke that instance every 2s, and each poke re-opens its window.
RestartPreventExitStatus=1
KillMode=mixed

[Install]
WantedBy=graphical-session.target
