# {{ ansible_managed }}
# Based on extra/linux/Alacritty.desktop from the alacritty source tree, with
# one deliberate change: Exec and TryExec are absolute.
#
# Upstream ships a bare `Exec=alacritty`, which only resolves if ~/.cargo/bin is
# on PATH. A .desktop entry is not launched through a shell, so it inherits the
# session's PATH — and nothing in qtile-session or LightDM adds ~/.cargo/bin.
# The hand-written entry this replaces on unick had already reached the same
# conclusion; it just lost the icon, categories and actions along the way.
[Desktop Entry]
Type=Application
TryExec={{ toolchains_cargo_bin }}/alacritty
Exec={{ toolchains_cargo_bin }}/alacritty
Icon=Alacritty
Terminal=false
Categories=System;TerminalEmulator;

Name=Alacritty
GenericName=Terminal
Comment=A fast, cross-platform, OpenGL terminal emulator
StartupNotify=true
StartupWMClass=Alacritty
Actions=New;

[Desktop Action New]
Name=New Terminal
Exec={{ toolchains_cargo_bin }}/alacritty
